{
  "telemetry": {
    "metrics": {
      "enabled": true,
      "buckets": [0.1, 0.5, 1, 5, 15, 50, 250, 500]
    },
    "tracing": {
      "isEnabled": false
    },
    "shared": {},
    "logger": {
      "level": "info",
      "prettyPrint": false,
      "opentelemetryOptions": {
        "enabled": false
      }
    }
  },
  "server": {
    "port": 8080
  },
  "app": {
    "project": {
      "name": "default"
    },
    "queueName": "3dtiler-queue",
    "parallelism": 1,
    "jobQueue": {
      "waitTimeout": 5000,
      "pgBoss": {
        "host": "localhost",
        "port": 5432,
        "username": "postgres",
        "password": "postgres",
        "schema": "pgboss",
        "ssl": {
          "enabled": false
        },
        "database": "postgres",
        "supervisor": true,
        "healthCheckTimeoutMs": 5000
      }
    },
    "tiling": {
      "contentLevels": [14, 15]
    }
  },
  "db": {
    "host": "localhost",
    "port": 5432,
    "username": "postgres",
    "password": "postgres",
    "ssl": {
      "enabled": false
    },
    "database": "postgres",
    "schema": "public",
    "healthCheckTimeoutMs": 5000
  }
}
