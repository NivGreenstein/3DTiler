{
  "name": "3dtiler",
  "version": "1.0.0",
  "description": "Worker that converts PostGIS buildings into 3D Tiles 1.1 GLB content",
  "main": "./src/index.ts",
  "scripts": {
    "test:unit": "vitest run --coverage.enabled=false --project unit",
    "test:integration": "vitest run --coverage.enabled=false --project integration",
    "test": "tsc --noEmit && vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prelint:fix": "npm run format:fix",
    "prelint": "npm run format",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prebuild": "npm run clean",
    "build": "tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json && npm run assets:copy",
    "start": "npm run build && cd dist && node --import ./instrumentation.mjs ./index.js",
    "start:dev": "npm run build && cd dist && node --enable-source-maps --import ./instrumentation.mjs ./index.js",
    "assets:copy": "copyfiles -f ./config/* ./dist/config && copyfiles ./package.json dist",
    "clean": "rimraf dist",
    "prepare": "node .husky/install.mjs"
  },
  "directories": {
    "test": "tests"
  },
  "author": "MapColonies",
  "license": "ISC",
  "dependencies": {
    "@godaddy/terminus": "^4.12.1",
    "@map-colonies/cleanup-registry": "^1.3.0",
    "@map-colonies/config": "^4.0.1",
    "@map-colonies/js-logger": "^5.0.0",
    "@map-colonies/prometheus": "^1.0.0",
    "@map-colonies/read-pkg": "^2.0.0",
    "@map-colonies/schemas": "^1.26.0",
    "@map-colonies/tracing": "^1.0.0",
    "@map-colonies/tracing-utils": "^2.0.0",
    "@opentelemetry/api": "^1.9.1",
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "serialize-error": "^8.1.0",
    "tsyringe": "^4.8.0",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@cesium/engine": "^22.3.0",
    "@commitlint/cli": "^21.2.2",
    "@map-colonies/commitlint-config": "^2.0.1",
    "@map-colonies/eslint-config": "^9.0.0",
    "@map-colonies/eslint-plugin": "^1.0.0",
    "@map-colonies/prettier-config": "^1.0.0",
    "@map-colonies/tile-calc": "^0.1.5",
    "@map-colonies/tsconfig": "^2.0.0",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "^4.1.8",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.9.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
